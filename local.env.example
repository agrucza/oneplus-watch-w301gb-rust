# Copy to local.env (which git ignores) and fill in.
# The watch's Bluetooth address, used by tools/ota.sh to reach it. (The Rust
# app reads its address from the watch's own factory data.)
OPW_MAC=AA:BB:CC:DD:EE:FF
# Optional:
# OPW_CHAN=2
# OPW_DIR=$HOME/opwatch/work
# OPW_TEMPLATE=$HOME/opwatch/work/B280STM32_ota.swdfull.bin
